# Server side only. Set these in Vercel project settings, never in the browser bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional. MTN subscription page users are sent to after signing up. If unset,
# MTN users are told they will receive the link by SMS.
MTN_SUBSCRIPTION_URL=
# Optional. Adds GNews stories to the news feed and powers /api/gnews.
GNEWS_API_KEY=
